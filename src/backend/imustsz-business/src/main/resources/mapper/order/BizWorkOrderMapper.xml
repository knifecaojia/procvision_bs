            <if test="prodOrderNo != null">prod_order_no = #{prodOrderNo},</if>
            <if test="prodBatchNo != null">prod_batch_no = #{prodBatchNo},</if>
            <if test="craftCode != null">craft_code = #{craftCode},</if>
            <if test="craftVersion != null">craft_version = #{craftVersion},</if>
