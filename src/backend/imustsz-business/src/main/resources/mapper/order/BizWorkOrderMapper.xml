            <if test="prodOrderNo != null">prod_order_no = #{prodOrderNo},</if>
            <if test="prodBatchNo != null">prod_batch_no = #{prodBatchNo},</if>
            <if test="craftCode != null">craft_code = #{craftCode},</if>
            <if test="craftVersion != null">craft_version = #{craftVersion},</if>
            <if test="status != null">status = #{status},</if>
            <if test="processCode != null">process_code = #{processCode},</if>
            <if test="processName != null">process_name = #{processName},</if>
            <if test="projectNo != null">project_no = #{projectNo},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="guideMapUrl != null">guide_map_url = #{guideMapUrl},</if>
            <if test="workerCode != null">worker_code = #{workerCode},</if>
            <if test="workerName != null">worker_name = #{workerName},</if>
            <if test="materialNo != null and materialNo != ''">material_no = #{materialNo},</if>
            <if test="materialName != null and materialName != ''">material_name = #{materialName},</if>
