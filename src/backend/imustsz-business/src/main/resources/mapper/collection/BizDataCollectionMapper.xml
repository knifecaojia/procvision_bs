<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.imustsz.collect.mapper.BizDataCollectionMapper">
    
    <resultMap type="BizDataCollection" id="BizDataCollectionResult">
        <result property="id"    column="id"    />
        <result property="imagePath"    column="image_path"    />
        <result property="data"    column="data"    />
        <result property="datasetId"    column="dataset_id"    />
        <result property="uploaded"    column="uploaded"    />
        <result property="type"    column="type"    />
        <result property="coordsInfo"   column="coords_info" />
        <result property="labelImage"   column="label_image" />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="remark"    column="remark"    />
        <result column="product_time" property="productTime"/>
        <result column="product_model" property="productModel"/>
        <result column="product_batch" property="productBatch"/>
        <result column="process_num" property="processNum"/>
        <result column="other_info" property="otherInfo"/>
    </resultMap>

    <sql id="selectBizDataCollectionVo">
        select id, image_path, data, dataset_id, label_image, coords_info, uploaded, type, create_time, remark, product_time, product_model, product_batch, process_num, other_info from biz_data_collection
    </sql>

    <select id="selectBizDataCollectionList" parameterType="BizDataCollection" resultMap="BizDataCollectionResult">
        <include refid="selectBizDataCollectionVo"/>
        <where>  
            <if test="imagePath != null  and imagePath != ''"> and image_path = #{imagePath}</if>
            <if test="data != null  and data != ''"> and data like concat('%',#{data},'%')</if>
            <if test="datasetId != null">and dataset_id = #{datasetId}</if>
            <if test="uploaded != null">and uploaded = #{uploaded}</if>
            <if test="type != null">and type = #{type}</if>
            <if test="coordsInfo != null and coordsInfo != ''">and coords_info = #{coordsInfo}</if>
            <if test="labelImage != null and labelImage != ''">and label_image = #{labelImage}</if>
            <if test="createTime != null"> and create_time = #{createTime}</if>
            <if test="updateTime != null">and update_time = #{updateTime}</if>
            <if test="createBy != null and createBy != ''">and create_by = #{createBy}</if>
            <if test="updateBy != null and updateBy != ''">and update_by = #{updateBy}</if>
            <if test="remark != null and remark != ''">and remark = #{remark}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectBizDataCollectionById" parameterType="Long" resultMap="BizDataCollectionResult">
        <include refid="selectBizDataCollectionVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizDataCollection" parameterType="BizDataCollection" useGeneratedKeys="true" keyProperty="id">
        insert into biz_data_collection
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="otherInfo != null">other_info,</if>
            <if test="processNum != null">process_num,</if>
            <if test="productBatch != null">product_batch,</if>
            <if test="productModel != null">product_model,</if>
            <if test="productTime != null">product_time,</if>
            <if test="imagePath != null">image_path,</if>
            <if test="data != null">data,</if>
            <if test="uploaded != null">uploaded,</if>
            <if test="type != null">type,</if>
            <if test="datasetId != null">dataset_id,</if>
            <if test="coordsInfo != null">coords_info,</if>
            <if test="labelImage != null">label_image,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="otherInfo != null">#{otherInfo},</if>
            <if test="processNum != null">#{processNum},</if>
            <if test="productBatch != null">#{productBatch},</if>
            <if test="productModel != null">#{productModel},</if>
            <if test="productTime != null">#{productTime},</if>
            <if test="imagePath != null">#{imagePath},</if>
            <if test="data != null">#{data},</if>
            <if test="uploaded != null">#{uploaded},</if>
            <if test="type != null">#{type},</if>
            <if test="datasetId != null">#{datasetId},</if>
            <if test="coordsInfo != null">#{coordsInfo},</if>
            <if test="labelImage != null">#{labelImage},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizDataCollection" parameterType="BizDataCollection">
        update biz_data_collection
        <trim prefix="SET" suffixOverrides=",">
            <if test="otherInfo != null">other_info = #{otherInfo},</if>
            <if test="processNum != null">process_num = #{processNum},</if>
            <if test="productBatch != null">product_batch = #{productBatch},</if>
            <if test="productModel != null">product_model = #{productModel},</if>
            <if test="productTime != null or productModel != null or productBatch != null or processNum != null or otherInfo != null">product_time = #{productTime,jdbcType=TIMESTAMP},</if>
            <if test="imagePath != null">image_path = #{imagePath},</if>
            <if test="data != null">data = #{data},</if>
            <if test="datasetId != null">dataset_id = #{datasetId},</if>
            <if test="uploaded != null">uploaded = #{uploaded},</if>
            <if test="type != null">type = #{type},</if>
            <if test="coordsInfo != null and coordsInfo != ''">coords_info = #{coordsInfo},</if>
            <if test="labelImage != null and labelImage != ''">label_image = #{labelImage},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizDataCollectionById" parameterType="Long">
        delete from biz_data_collection where id = #{id}
    </delete>

    <delete id="deleteBizDataCollectionByIds" parameterType="String">
        delete from biz_data_collection where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="checkData" resultMap="BizDataCollectionResult">
        <include refid="selectBizDataCollectionVo"/>
        where data = #{data} and `type` = 1
    </select>

    <select id="selectUploadData" resultMap="BizDataCollectionResult">
        <include refid="selectBizDataCollectionVo" />
        where uploaded = 1 and `type` = 0 limit 5
    </select>

    <select id="selectDeleteData" resultMap="BizDataCollectionResult">
        <include refid="selectBizDataCollectionVo" />
        where uploaded = 0 and `type` = 0 limit #{limit}
    </select>

    <delete id="deleteData">
        delete from biz_data_collection where uploaded = 0 and `type` = 0 limit 50
    </delete>
</mapper>
